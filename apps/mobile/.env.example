# Copy to .env.
# Web on this PC:          http://localhost:4000
# Phone with Expo Go:      your PC's Wi-Fi IP, e.g. http://192.168.1.20:4000
# Production web build:    same-origin   (the site proxies /api to the API; see vercel.json)
# Production phone builds: set in eas.json (https://lifeledger-api-dknx.onrender.com)
EXPO_PUBLIC_API_URL=http://localhost:4000
