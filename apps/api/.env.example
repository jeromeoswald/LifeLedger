# Copy to .env and fill in. In production (Render) set these in the dashboard instead.
PORT=4000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/lifeledger   Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/lifeledger
MONGODB_URI=mongodb://127.0.0.1:27017/lifeledger
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-1
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-2
# Comma-separated web origins allowed to call the API with cookies (Expo web dev server / live site).
CORS_ORIGINS=http://localhost:8081
# The live web app URL (Web Push contact + notification links). Dev: http://localhost:8081
WEB_URL=http://localhost:8081
# Rate providers
FX_PRIMARY_URL=https://open.er-api.com/v6/latest/USD
FX_FALLBACK_URL=https://api.frankfurter.dev/v1
# Optional tuning
# RATE_LIMIT_PER_MIN=600
# AUTH_RATE_LIMIT_PER_15MIN=50
# Optional: Web Push keys. If unset, a key pair is generated on first start and kept in MongoDB.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
