# Copy to .env and fill in.
PORT=4000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/lifeledger   Atlas: mongodb+srv://user:pass@cluster.x.mongodb.net/lifeledger
MONGODB_URI=mongodb://127.0.0.1:27017/lifeledger
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-1
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-2
# Comma-separated web origins allowed to call the API with cookies (Expo web dev server).
CORS_ORIGINS=http://localhost:8081
# Rate providers (used from Phase 4)
FX_PRIMARY_URL=https://open.er-api.com/v6/latest/USD
FX_FALLBACK_URL=https://api.frankfurter.dev/v1
